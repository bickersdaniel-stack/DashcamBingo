{
  "name": "dashcam-bingo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "DATA_DIR=data-dev PORT=3300 PUBLIC_URL=http://localhost:3300 node --disable-warning=ExperimentalWarning --env-file=.env --watch server/index.js",
    "dev:copy-live": "node --disable-warning=ExperimentalWarning server/copy-live.js",
    "test": "DATA_DIR=:memory: node --disable-warning=ExperimentalWarning --test server/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}

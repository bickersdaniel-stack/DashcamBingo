# Copy this to .env and fill it in. Never commit .env: the repo is public.

# From https://discord.com/developers/applications > your app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Any long random string, for example from: openssl rand -hex 32
SESSION_SECRET=

# The address people use. npm run dev swaps in http://localhost:3300 for testing.
PUBLIC_URL=https://bingo.example.com
PORT=3000

# Optional: Sign in with Google (Google Cloud > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email sign-in links, sent with Resend (resend.com > API keys)
RESEND_API_KEY=
EMAIL_FROM=Dashcam Bingo <bingo@dkb.lol>

# Who can approve suggested squares: player ids, comma-separated (yours shows at /api/me)
ADMIN_IDS=
